DOLLY_ACCESS_HOSTNAME=dolly.your-subdomain.workers.dev
DOLLY_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
DOLLY_ACCESS_EMAILS=you@example.com
# The UUID from Zero Trust > Access > Service Auth (not the client ID).
DOLLY_ACCESS_SERVICE_TOKEN_ID=existing-service-token-uuid
# Set this when adopting an existing Access application, preserving its AUD.
# DOLLY_ACCESS_APPLICATION_ID=existing-application-uuid
