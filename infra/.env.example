PI_HARD_ACCESS_HOSTNAME=pi-hard.your-subdomain.workers.dev
PI_HARD_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
PI_HARD_ACCESS_EMAILS=you@example.com
# The UUID from Zero Trust > Access > Service Auth (not the client ID).
PI_HARD_ACCESS_SERVICE_TOKEN_ID=existing-service-token-uuid
# Set this when adopting an existing Access application, preserving its AUD.
# PI_HARD_ACCESS_APPLICATION_ID=existing-application-uuid
