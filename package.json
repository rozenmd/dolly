{
  "name": "pi-hard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy": "cf deploy",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "build": "cf deploy --dry-run",
    "login": "node --env-file-if-exists=.dev.vars scripts/connect.mjs",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.3",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "effect": "4.0.0-rc.112",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.7.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@oxlint/plugins": "1.93.0",
    "cf": "1.0.0-beta.29",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  }
}
